[Unit]
Description=Tailscale Funnel for Jarvis (publishes only the phone-call routes)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Only the Telnyx routes and the health check go public. /events (Claude
# hook ingest) stays loopback-only.
ExecStart=/usr/bin/tailscale funnel --bg --set-path=/ws/telnyx http://127.0.0.1:8000/ws/telnyx
ExecStart=/usr/bin/tailscale funnel --bg --set-path=/texml http://127.0.0.1:8000/texml
ExecStart=/usr/bin/tailscale funnel --bg --set-path=/health http://127.0.0.1:8000/health
ExecStop=/usr/bin/tailscale funnel --https=443 off

[Install]
WantedBy=default.target
