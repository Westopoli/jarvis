[Unit]
Description=Jarvis voice assistant server
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/jarvis
# Secrets and identifiers live in the gitignored .env (also read by
# jarvis.config.load_config, so manual runs need no `source`).
EnvironmentFile=%h/Projects/jarvis/.env
Environment=OLLAMA_KEEP_ALIVE=-1
ExecStart=/usr/bin/env uv run jarvis
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
