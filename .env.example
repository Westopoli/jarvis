# Copy to .env (gitignored) and fill in. jarvis.config reads .env itself.

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=-1

# LLM backend: "ollama" (default, fully local) or "groq" (cloud, faster,
# immune to local GPU contention; auto-fails-over to Ollama on error).
JARVIS_LLM_PROVIDER=ollama
# console.groq.com -> API Keys. Required if JARVIS_LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# platform.deepseek.com -> API keys. Required if JARVIS_LLM_PROVIDER=deepseek.
# deepseek-chat is the non-reasoning endpoint -- use this, not
# deepseek-reasoner, which "thinks" before every reply and is too slow for
# voice (multi-second time-to-first-token even for a short answer).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# tmux
JARVIS_TMUX_SESSION=main
JARVIS_RENAME_WINDOWS=1

# Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Phone (Twilio). Console home page shows Account SID and Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your mobile in E.164 (+1 and ten digits). Comma-separate several.
JARVIS_ALLOWED_CALLER=
# Public hostname Twilio reaches via Tailscale Funnel
JARVIS_PUBLIC_HOSTNAME=

# Telnyx (alternative provider, unused with Twilio)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
